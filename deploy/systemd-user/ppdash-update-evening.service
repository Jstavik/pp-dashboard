[Unit]
Description=PP Dashboard — večerní aktualizace bez ENTSO-E (plyn, Energy-Charts, Nordic)

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/ppdash/env
Environment=PPDASH_DATA_DIR=@DATA@
Environment=ARROW_DEFAULT_MEMORY_POOL=system
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV@/bin/python scripts/update_all.py --skip power
TimeoutStartSec=3h
Nice=10
CPUWeight=50
IOWeight=50
MemoryMax=1000M
# exit 3 = jiná aktualizace právě běží — není to chyba
SuccessExitStatus=3
NoNewPrivileges=yes
