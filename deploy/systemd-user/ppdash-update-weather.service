[Unit]
Description=PP Dashboard — počasí Open-Meteo (předpověď + ERA5)

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/ppdash/env
Environment=PPDASH_DATA_DIR=@DATA@
Environment=ARROW_DEFAULT_MEMORY_POOL=system
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
# vlastní zámek .weather.lock — běží souběžně s ostatními aktualizacemi
# historie ERA5 se dohání po částech (PPDASH_WEATHER_BUDGET_CALLS na běh)
ExecStart=@VENV@/bin/python scripts/update_all.py --only weather
TimeoutStartSec=1h
Nice=10
CPUWeight=50
IOWeight=50
MemoryMax=500M
SuccessExitStatus=3
NoNewPrivileges=yes
