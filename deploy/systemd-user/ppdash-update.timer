[Unit]
Description=PP Dashboard — ranní aktualizace historie 06:00 (Praha), vše kromě live/COT/ENTSO-E skupiny

[Timer]
# Časové pásmo přímo v OnCalendar — nezávisí na nastavení kontejneru (bez roota).
OnCalendar=*-*-* 06:00:00 Europe/Prague
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
