[Unit]
Description=PP Dashboard — web (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ppdash
Group=ppdash
WorkingDirectory=/opt/ppdash/app
EnvironmentFile=-/home/ppdash/.config/ppdash/env
Environment=PPDASH_DATA_DIR=/var/lib/ppdash
Environment=ARROW_DEFAULT_MEMORY_POOL=system
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
# Jen localhost — ven se publikuje přes Cloudflare Tunnel (+ Access).
ExecStart=/opt/ppdash/venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8501 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
# 2 GB LXC: web drží ~0.5 GB, update běží vedle něj
MemoryHigh=1100M
MemoryMax=1400M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ppdash
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
