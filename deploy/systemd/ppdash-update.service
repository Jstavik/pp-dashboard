[Unit]
Description=PP Dashboard — aktualizace historie (vše kromě COT)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ppdash
Group=ppdash
WorkingDirectory=/opt/ppdash/app
EnvironmentFile=-/home/ppdash/.config/ppdash/env
Environment=PPDASH_DATA_DIR=/var/lib/ppdash
Environment=ARROW_DEFAULT_MEMORY_POOL=system
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ppdash/venv/bin/python scripts/update_all.py
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
MemoryMax=1000M
# exit 3 = jiná aktualizace právě běží — není to chyba
SuccessExitStatus=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ppdash
