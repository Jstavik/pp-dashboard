[Unit]
Description=PP Dashboard — ICE CoT sobota (primárně) + úterý (retry po svátcích)

[Timer]
# ICE publikuje v pátek ~18:30 London; úterý = záloha, když se publikace posune
OnCalendar=Sat *-*-* 08:00:00
OnCalendar=Tue *-*-* 08:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
