# PP Dashboard — tajné klíče a konfigurace.
# deploy/install_user.sh ho zkopíruje do ~/.config/ppdash/env (chmod 600).
# Načítá ho systemd (EnvironmentFile) i ruční spuštění skriptů.
# NIKDY sem nedávej skutečné hodnoty v repu.

# ENTSO-E Transparency Platform (DAP, generace, odstávky, rezervy, hydro)
ENTSOE_TOKEN=

# GIE AGSI+ / ALSI (zásobníky plynu, LNG) — jeden klíč pro obě API
GIE_API_KEY=

# Kořen dat mimo git — unity ho nastavují samy (~/ppdash-data);
# tady jen pro ruční spouštění skriptů z shellu. Historie je v $PPDASH_DATA_DIR/history
# PPDASH_DATA_DIR=/home/claude/ppdash-data
# Disková cache (default $PPDASH_DATA_DIR/cache)
# PPDASH_CACHE_DIR=
# Max souběžně počítaných požadavků webu (default 8)
# PPDASH_THREADS=8

# ENTSO-E backfill / rate limit (volitelné)
# PPDASH_ENTSOE_START=2019-01-01
# PPDASH_ENTSOE_FLOWS_START=2021-01-01
# PPDASH_ENTSOE_RPM=250
# PPDASH_ENTSOE_BUDGET_S=2400
# Nordic
# FINGRID_API_KEY=
