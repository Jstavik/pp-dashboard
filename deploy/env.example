# PP Dashboard — tajné klíče a konfigurace.
# Zkopíruj do ~/.config/ppdash/env (uživatel ppdash: /home/ppdash/.config/ppdash/env),
# chmod 600. Načítá ho systemd (EnvironmentFile) i ruční spuštění skriptů.
# NIKDY sem nedávej skutečné hodnoty v repu.

# ENTSO-E Transparency Platform (DAP, generace, odstávky, rezervy, hydro)
ENTSOE_TOKEN=

# GIE AGSI+ / ALSI (zásobníky plynu, LNG) — jeden klíč pro obě API
GIE_API_KEY=

# Kořen dat mimo git (default /var/lib/ppdash); historie je v $PPDASH_DATA_DIR/history
# PPDASH_DATA_DIR=/var/lib/ppdash
# Disková cache (default $PPDASH_DATA_DIR/cache)
# PPDASH_CACHE_DIR=
# Max souběžně počítaných požadavků webu (default 8)
# PPDASH_THREADS=8
